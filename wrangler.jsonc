{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourtecheye",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "yourtecheye"
    }
  ],
  "routes": [
    {
      "pattern": "yourtecheye.com",
      "custom_domain": true
    },
    {
      "pattern": "www.yourtecheye.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
