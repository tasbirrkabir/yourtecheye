generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Enquiries submitted through the public contact form.
/// Submissions are always stored here so no lead is silently lost;
/// email forwarding happens on top when delivery credentials are configured.
model ContactSubmission {
  id           String   @id @default(cuid())
  name         String
  organization String?
  email        String?
  phone        String?
  service      String?
  contactMethod String? // preferred reply channel chosen by the enquirer
  cameraCount  String?  // rough camera count range for pre-qualification
  timeframe    String?  // how soon the enquirer wants monitoring live
  siteLocation String?
  message      String
  emailSent    Boolean  @default(false)
  ipHash       String?  // hashed client IP for rate limiting/audit — never the raw IP
  userAgent    String?
  createdAt    DateTime @default(now())
}

/// Blog posts / case notes. Written and managed from the admin panel
/// (/admin); only status="published" rows are visible on the public site.
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String // markdown-lite body (headings, lists, notes, figures)
  coverImage  String? // path under /public: /media/... or /uploads/...
  gallery     String    @default("[]") // JSON array of { src, alt }
  tags        String    @default("") // comma-separated
  author      String    @default("Md Al-Amin")
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  readMinutes Int       @default(3)
  sourceUrl   String? // optional attribution link (e.g. author's LinkedIn)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
